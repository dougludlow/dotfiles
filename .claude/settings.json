{
	"permissions": {
		"allow": [
			"Edit",
			"Glob",
			"Grep",
			"LS",
			"MultiEdit",
			"Read",
			"Bash(cat *)",
			"Bash(cat:*)",
			"Bash(cd *)",
			"Bash(echo:*)",
			"Bash(find *)",
			"Bash(gh pr create *)",
			"Bash(git *)",
			"Bash(git commit:*)",
			"Bash(git diff:*)",
			"Bash(grep *)",
			"Bash(head *)",
			"Bash(ls *)",
			"Bash(node *)",
			"Bash(npm *)",
			"Bash(npx jest *)",
			"Bash(npx nx *)",
			"Bash(nx *)",
			"Bash(pnpm *)",
			"Bash(python3 *)",
			"Bash(tail *)"
		],
		"deny": [
			"Read(**/.env*)",
			"Read(**/.dev.vars*)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/secrets/**)",
			"Read(**/credentials/**)",
			"Read(**/.aws/**)",
			"Read(**/.ssh/**)",
			"Read(**/config/database.yml)",
			"Read(**/config/credentials.json)",
			"Read(**/.npmrc)",
			"Read(**/.pypirc)",
			"Write(**/.env*)",
			"Write(**/secrets/**)",
			"Write(**/.ssh/**)"
		],
		"defaultMode": "auto"
	},
	"hooks": {
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"/Users/doug.ludlow/.config/iterm2/it2\" handle-agent-hook"
					}
				]
			}
